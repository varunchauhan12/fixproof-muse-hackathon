# ==============================================================================
# FixProof Backend Environment Configuration Template
# Copy this file to backend/.env and replace placeholders. Never commit backend/.env!
# ==============================================================================

# ── 1. Operational Mode ───────────────────────────────────────────────────────
# Options: 'local' (default) or 'supabase'
# Keep 'local' for normal local development. Set to 'supabase' to enable cloud PostgreSQL.
FIXPROOF_DB_MODE=local

# ── 2. Supabase PostgreSQL Connection URI ─────────────────────────────────────
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# NOTE: Use the Connection Pooler URI (port 6543) for reliable IPv4 connectivity.
# Replace [YOUR-PASSWORD] with your actual database password.
# Example:
# SUPABASE_DB_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres

# ── 3. Supabase API Credentials (for future Storage milestones) ───────────────
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_public_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_secret_service_role_key_here

# ── 4. Nebius Token Factory (NVIDIA Nemotron Inference) ───────────────────────
# Obtain from: Nebius Token Factory Dashboard
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# ── 5. Meta Muse Inference (Hackathon Multimodal Integration) ──────────────────
# Configuration placeholders for the Meta Muse multimodal reasoning integration.
# Kept strictly independent from Nebius/Nemotron credentials.
# NOTE: Active Muse client integration is in preparation/scaffolding.
MUSE_API_KEY=your_meta_muse_api_key_here
MUSE_BASE_URL=https://api.muse.example.com/v1
MUSE_MODEL=meta-models/muse-spark-open

# ── 6. Cryptographic Evidence Package Signing (Phase 1.5 - Ed25519) ───────────
# Optional 32-byte hex seed (64 hex characters) for Ed25519 manifest signing.
# If omitted, FixProof generates an ephemeral dev key automatically for local testing.
# Generate a secure key via: python3 -c "import secrets; print(secrets.token_hex(32))"
FIXPROOF_SIGNING_KEY_HEX=
# Optional signing key identifier
FIXPROOF_SIGNING_KEY_ID=ed25519:fixproof-custody-primary
# Set to 'true' in production environments to strictly require a configured key
FIXPROOF_REQUIRE_CONFIGURED_SIGNING_KEY=false